# API Configuration
VITE_API_URL=http://laravel-api

# Storage Configuration
VITE_STORAGE_URL=http://localhost

# Google OAuth — must match GOOGLE_CALLBACK_URL in backend .env
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_OAUTH_CALLBACK_URL=http://localhost/api/oauth2/callback/google

# Reverb WebSocket — must match REVERB_* values in backend .env
PUBLIC_REVERB_APP_KEY=your_reverb_app_key
PUBLIC_REVERB_HOST=localhost
PUBLIC_REVERB_PORT=6001
PUBLIC_REVERB_SCHEME=http